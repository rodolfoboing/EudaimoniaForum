<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textMotivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivo: Spam"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#D32F2F" />

        <TextView
            android:id="@+id/textPostId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post ID: ..."
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/textData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data: ..."
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:textColor="#757575"/>

        <TextView
            android:id="@+id/textConteudoDenunciado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conteúdo: ..."
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="#FFF3E0"
            android:textColor="#BF360C"
            android:maxLines="4"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnVerPostBotao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ver Post"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnApagarConteudo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apagar"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F44336"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnResolver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resolver"
                android:layout_marginStart="4dp"
                android:backgroundTint="#4CAF50"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
