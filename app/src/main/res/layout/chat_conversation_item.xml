<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:elevation="1dp"
    android:orientation="horizontal">

    <!-- Barra lateral colorida - indica conversation não lida -->
    <View
        android:id="@+id/barraLateralNaoLida"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#2196F3"
        android:visibility="gone" />

    <!-- Conteúdo da conversation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha Superior: Nome + Hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nome do Usuário -->
            <TextView
                android:id="@+id/textViewNomeUsuario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome do Usuário"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Container Hora + Ícone -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Hora da Última Mensagem -->
                <TextView
                    android:id="@+id/textViewHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <!-- Ícone envelope - indica não lida -->
                <ImageView
                    android:id="@+id/iconEnvelopeNaoLido"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Conversa não lida"
                    android:src="@drawable/ic_envelope_closed"
                    android:visibility="gone"
                    app:tint="#2196F3" />
            </LinearLayout>
        </LinearLayout>

        <!-- Última Mensagem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Texto da Última Mensagem -->
            <TextView
                android:id="@+id/textViewUltimaMensagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Última mensagem enviada na conversation..."
                android:textColor="#616161"
                android:textSize="14sp" />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>