<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_conquista"
    android:elevation="16dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Glow dourado atrás do troféu -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center">

        <View
            android:id="@+id/viewGlowBackground"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_glow_conquista" />

        <!-- Ícone do Troféu -->
        <ImageView
            android:id="@+id/imageViewTrofeu"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="Troféu de conquista"
            android:src="@drawable/ic_avatar_20" />
    </FrameLayout>

    <!-- Estrelas decorativas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="✨ ✨ ✨"
        android:textSize="24sp" />

    <!-- Título fixo -->
    <TextView
        android:id="@+id/textViewConquistaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="NOVA CONQUISTA!"
        android:textAlignment="center"
        android:textColor="#FFA000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <!-- Nome da Medalha -->
    <TextView
        android:id="@+id/textViewConquistaNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Medalha de 1 Dia"
        android:textAlignment="center"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Mensagem motivacional -->
    <TextView
        android:id="@+id/textViewConquistaMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Parabéns pelo seu compromisso!"
        android:textAlignment="center"
        android:textColor="#666666"
        android:textSize="15sp" />

    <!-- Separador dourado -->
    <View
        android:layout_width="120dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:background="#FFD700" />

    <!-- Botão Ver Perfil -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonVerPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFD700"
        android:text="🏆 Ver meu Perfil"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

    <!-- Botão Continuar -->
    <TextView
        android:id="@+id/textViewFechar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:text="Continuar"
        android:textColor="#999999"
        android:textSize="14sp" />

</LinearLayout>
