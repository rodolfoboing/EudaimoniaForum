<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textViewAutorComentario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autor do Comentário"
        android:textColor="#00BCD4"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewConteudoComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Conteúdo do comentário aqui..."
        android:textColor="#212121"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/textViewDataComentario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="20/11/2025"
            android:textSize="10sp"
            android:textColor="#9E9E9E" />

        <ImageView
            android:id="@+id/btnOpcoesComentario"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="Opções do comentário"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#B0BEC5"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#EEEEEE"/>

</LinearLayout>