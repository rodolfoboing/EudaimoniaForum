<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#E3F2FD"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp">

    <TextView
        android:id="@+id/textViewTituloPost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título da Postagem"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="0dp"/>

    <TextView
        android:id="@+id/textViewResumoPost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumo da Postagem"
        android:textSize="13sp"
        android:layout_marginTop="1dp"
        android:textColor="#424242"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewAutor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Autor: Nome"
            android:textSize="11sp"
            android:textColor="#757575"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/textViewData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/01/2024"
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewComentarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 0"
            android:textSize="11sp"
            android:textColor="#757575" />

        <ImageView
            android:id="@+id/imageViewDeletePost"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:tint="#F44336" />

        <Button
            android:id="@+id/buttonAddComment"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:backgroundTint="#8BC34A"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="Comentar"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>