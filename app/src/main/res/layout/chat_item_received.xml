<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="64dp"
    android:paddingBottom="4dp">

    <!-- Nome do Remetente (Opcional, para grupos) -->
    <TextView
        android:id="@+id/textViewSenderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="2dp"
        android:text="Nome do Usuário"
        android:textColor="#757575"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Balão da Mensagem Recebida -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_receive"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Texto da Mensagem -->
        <TextView
            android:id="@+id/textViewMessageReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esta é uma mensagem recebida de outra pessoa!"
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Hora da Mensagem -->
        <TextView
            android:id="@+id/textViewTimeReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="14:30"
            android:textColor="#757575"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>