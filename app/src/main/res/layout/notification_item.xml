<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayoutNotificacao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E3F2FD"
    android:elevation="4dp"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- Conteúdo da Notificação -->
    <TextView
        android:id="@+id/textNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:text="Mensagem de notificação"
        android:textColor="#000000"
        android:textSize="16sp" />

    <!-- Data e Botão -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 horas atrás"
            android:textColor="#757575"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonViewPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#03A9F4"
            android:text="Ver Post"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>