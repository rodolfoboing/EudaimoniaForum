<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissões -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EudaimoniaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_eudaimoniaforum"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_eudaimoniaforum"
        android:supportsRtl="true"
        android:theme="@style/Theme.App_Conquistas_2"
        tools:targetApi="31">

        <!-- Activities Novas -->
        <activity android:name=".chat.ChatActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".chat.ConversationActivity" />
        <activity android:name=".auth.RecoverPasswordActivity" />
        <activity android:name=".forum.MyPostActivity" />

        <activity
            android:name=".notification.NotificationActivity"
            android:exported="false" />
        <activity
            android:name=".forum.CommentActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".onboarding.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".profile.ViewProfileActivity" />
        <activity android:name=".auth.LoginActivity" />
        <activity
            android:name=".main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="OPEN_MAIN_ACTIVITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".auth.RegisterActivity" />
        <activity android:name=".profile.SetupProfileActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".main.EditAbstinenceActivity" />
        <activity android:name=".profile.ProfileActivity" />
        <activity android:name=".forum.ForumActivity" />
        <activity android:name=".profile.EditProfileActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".forum.NewPostActivity"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".notification.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Configuração do Canal Padrão para Notificações em Background (Obrigatório no Android Oreo+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fcm_default_channel" />
        
        <activity android:name=".onboarding.OnboardingActivity" />
        <activity android:name=".orientation.OrientationActivity" />
        <activity android:name=".moderation.ModerationActivity" />
        <activity android:name=".moderation.ReportActivity" />
    </application>

</manifest>